{
    "manifest_version": 3,
    "name": "Cozy Haven Tab",
    "version": "2.0",
    "description": "Tab baru yang hangat: shortcut tanpa batas, to-do, catatan, dan cuaca dalam satu meja kerja.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "topSites"
    ],
    "host_permissions": [
        "https://api.open-meteo.com/*",
        "https://geocoding-api.open-meteo.com/*"
    ]
}
